{
  "name": "okane",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Okane: app pessoal de gastos que faz cada gasto pesar na hora.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:previa": "vite build --mode previa && node scripts/previa.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.functions.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --trace off"
  },
  "dependencies": {
    "dexie": "^4.4.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "fake-indexeddb": "^6.2.8",
    "svelte": "^5.59.1",
    "svelte-check": "^4.4.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-window": "^7.4.1"
  }
}
